    "Learn AI on this phone": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这部手机上学 AI"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這部手機上學 AI"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende IA en este teléfono"
          }
