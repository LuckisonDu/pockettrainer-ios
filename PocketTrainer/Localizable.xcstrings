    },
    "This project can be read and edited. PocketTrainer can only run recipes with its built-in trainer (not full Python or PyTorch).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个项目可以阅读和修改。PocketTrainer 只能用内置训练器运行“配方”（不是完整的 Python 或 PyTorch）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個專案可以閱讀和修改。PocketTrainer 只能用內建訓練器執行“配方”（不是完整的 Python 或 PyTorch）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto se puede leer y editar. PocketTrainer solo puede ejecutar recetas con su entrenador integrado (no Python completo ni PyTorch)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet peut être lu et modifié. PocketTrainer ne peut exécuter que des recettes avec son entraîneur intégré (pas Python complet ni PyTorch)."
          }
        }
      }
    },
    "This repository is too large to list. Use a link to a sub-folder, like github.com/<owner>/<repo>/tree/<branch>/<folder>.": {
