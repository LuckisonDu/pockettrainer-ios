    "Validation loss is higher than training loss by %.2f. The model may be memorising the photos: try fewer epochs or fewer hidden units.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证损失比训练损失高 %.2f。模型可能在死记硬背照片：试试减少训练轮数或隐藏单元。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證損失比訓練損失高 %.2f。模型可能在死記硬背照片：試試減少訓練輪數或隱藏單元。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de validación es %.2f mayor que la de entrenamiento. El modelo puede estar memorizando las fotos: prueba menos épocas o menos unidades ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La perte de validation dépasse celle d'entraînement de %.2f. Le modèle mémorise peut-être les photos : essayez moins d'époques ou moins d'unités cachées."
          }
        }
      }
    },
