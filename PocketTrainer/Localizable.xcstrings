          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las columnas numéricas se convierten en características. No se admiten columnas de texto. La etiqueta necesita de 2 a 10 valores distintos. Las tablas pequeñas se repiten para llenar los lotes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les colonnes numériques deviennent des caractéristiques. Les colonnes texte ne sont pas prises en charge. L'étiquette doit avoir de 2 à 10 valeurs différentes. Les petites tables sont répétées pour remplir les lots."
