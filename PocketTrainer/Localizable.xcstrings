    "Verification found and fixed wrong GPU steps: %ld. Without it this run could have been silently wrong.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校验发现并修复了出错的 GPU 步骤：%ld 个。没有它，这次运行可能悄悄出错。"
          }
        },
        "zh-Hant": {
