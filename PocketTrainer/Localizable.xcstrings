    "These buttons break training on purpose, to show what the protection does. Then go back and press Run.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些按钮会故意破坏训练，用来展示保护的作用。然后返回并点运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些按鈕會故意破壞訓練，用來展示保護的作用。然後返回並點執行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos botones estropean el entrenamiento a propósito, para mostrar lo que hace la protección. Luego vuelve y pulsa Ejecutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces boutons perturbent l'entraînement exprès, pour montrer ce que fait la protection. Revenez ensuite et appuyez sur Exécuter."
          }
        }
      }
    },
    "This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法撤銷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        }
      }
    },
    "This coach only looks at the numbers of your recent runs. It does not use the internet or a large AI model.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个教练只看你最近几次运行的数字。它不用网络，也不用大型 AI 模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個教練只看你最近幾次執行的數字。它不用網路，也不用大型 AI 模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este entrenador solo mira los números de tus últimas ejecuciones. No usa internet ni un modelo de IA grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce coach ne regarde que les chiffres de vos dernières exécutions. Il n'utilise ni internet ni grand modèle d'IA."
          }
        }
      }
    },
    "This is too big to import (%ld files, %.1f MB; limits: 200 files, 5 MB). Pick a sub-folder.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
