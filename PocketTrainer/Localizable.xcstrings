    "Checkpoints let training continue after a crash. Verifying re-computes every step on the CPU and fixes wrong GPU results.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档让训练在闪退后能继续。校验会在 CPU 上重算每一步，并修正 GPU 的错误结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存檔讓訓練在閃退後能繼續。校驗會在 CPU 上重算每一步，並修正 GPU 的錯誤結果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos de control permiten continuar el entrenamiento tras un fallo. La verificación recalcula cada paso en la CPU y corrige los resultados erróneos de la GPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points de contrôle permettent de reprendre après un plantage. La vérification recalcule chaque étape sur le CPU et corrige les résultats faux du GPU."
          }
        }
      }
    },
