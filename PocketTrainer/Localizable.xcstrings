    "Number columns become features. Text columns are not supported. The label needs 2 to 10 different values. Small tables are repeated to fill training batches.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字列会变成特征，文本列不支持。标签需要有 2 到 10 种不同取值。小表格会被重复使用来凑满训练批次。"
          }
        },
