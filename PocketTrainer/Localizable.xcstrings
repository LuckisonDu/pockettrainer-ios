          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載開源的文字檔案，然後閱讀、修改，（配方專案）還能訓練。PocketTrainer 只在匯入時聯網。"
          }
        },
