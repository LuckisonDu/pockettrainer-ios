    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketTrainer 只用语音识别在这部手机上把你的声音转成文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketTrainer 只用語音識別在這部手機上把你的聲音轉成文字。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketTrainer usa el reconocimiento de voz solo para convertir tu voz en texto en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketTrainer utilise la reconnaissance vocale uniquement pour transformer votre voix en texte sur ce téléphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketTrainer uses speech recognition only to turn your voice into text on this phone."
          }
        }
      }
    },
